{
  "name": "docs-assistant-web",
  "version": "0.1.0",
  "private": true,
  "description": "The website: sign in, folders, uploads and chat. It talks to the TypeScript API, never to the database.",
  "scripts": {
    "dev": "node --env-file=../.env ./node_modules/next/dist/bin/next dev --port 3000",
    "build": "node --env-file=../.env ./node_modules/next/dist/bin/next build",
    "start": "node --env-file=../.env ./node_modules/next/dist/bin/next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.6"
  }
}
