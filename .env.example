# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-key-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_assistant
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379
# Safety limits for the AI calls
MAX_AGENT_STEPS=5
MAX_REQUESTS_PER_DAY=200

# Which service writes the answers. Options: gemini, groq, openrouter, mistral
LLM_PROVIDER=gemini
# Optional: providers to try, in order, if the main one fails
LLM_FALLBACK=
# Keys for any provider you use (paste your own)
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Optional model overrides: GEMINI_MODEL, GROQ_MODEL, OPENROUTER_MODEL, MISTRAL_MODEL, JUDGE_MODEL

# Embeddings run on your own computer through Ollama (install from ollama.com, then: ollama pull nomic-embed-text)
# Optional: OLLAMA_URL=http://localhost:11434   EMBED_MODEL=nomic-embed-text

# ---------- The website (web/), the API (api/) and the Python service ----------
# Three different secrets, each at least 32 characters. Make each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# website -> API: proves which user is asking
API_JWT_SECRET=
# website -> API: sign-up and login only
INTERNAL_SECRET=
# API -> Python service
RAG_SERVICE_SECRET=
# Used by Auth.js to sign the login cookie (make another with the same command)
AUTH_SECRET=
# Optional: "Continue with Google" appears only when both are set (see docs/RUNNING-THE-APP.md)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Where things run (these defaults are fine locally)
API_PORT=4000
API_URL=http://127.0.0.1:4000
RAG_SERVICE_URL=http://127.0.0.1:8000
# Uploaded files are stored here (default: storage/uploads in the project)
# UPLOAD_DIR=
